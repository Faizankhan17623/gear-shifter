{
  "name": "gear-shifter",
  "productName": "Gear Shifter",
  "version": "1.0.0",
  "description": "A literal car gear-shifter UI for switching Claude Code models",
  "main": "dist-electron/main/main.js",
  "type": "commonjs",
  "author": "",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-rebuild -f -w @nut-tree-fork/libnut-win32",
    "dev": "vite",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-store": "^8.2.0",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^39.8.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.gearshifter.app",
    "productName": "Gear Shifter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
